+import test from 'node:test'
+import assert from 'node:assert/strict'
+import {
+  AUDIO_HEADING_TOLERANCE_DEG,
+  AUDIO_TRIGGER_DISTANCE_M,
+  audioHeadingOk,
+  decidePinAudio,
+  type PinAudioDecision,
+} from './pin-audio.ts'
+
+type Fix = { dists: number[]; ok?: boolean[] }
+
+function makeRunner(ids: string[]) {
+  const triggered = new Set<string>()
+  const minDist = new Map<string, number>()
+  const played: string[] = []
+  return {
+    triggered,
+    played,
+    step(fix: Fix, busy = false): PinAudioDecision | null {
+      const d = decidePinAudio({
+        pinIds: ids,
+        triggered,
+        distanceTo: (i) => fix.dists[i],
+        headingOkAt: (i) => fix.ok?.[i] ?? true,
+        minDist,
+        busy,
+      })
+      if (d) {
+        d.skipped.forEach((i) => triggered.add(ids[i]))
+        triggered.add(ids[d.index])
+        played.push(ids[d.index])
+      }
+      return d
+    },
+  }
+}
+
+test('audio constants: 20 m trigger, 90° heading tolerance', () => {
+  assert.equal(AUDIO_TRIGGER_DISTANCE_M, 20)
+  assert.equal(AUDIO_HEADING_TOLERANCE_DEG, 90)
+})
+
+test('plays the next PIN at 20 m, not at 25 m', () => {
+  const r = makeRunner(['a', 'b'])
+  assert.equal(r.step({ dists: [25, 300] }), null)
+  assert.equal(r.step({ dists: [19, 300] })?.reason, 'in-range')
+  assert.deepEqual(r.played, ['a'])
+})
+
+test('heading gate: blocked when wrong direction while moving, ignored when almost stationary', () => {
+  assert.equal(audioHeadingOk(false, 8), false)
+  assert.equal(audioHeadingOk(true, 8), true)
+  assert.equal(audioHeadingOk(false, 0.3), true)
+  assert.equal(audioHeadingOk(false, null), false)
+})
+
+test('wrong heading alone does not lose the voice: it plays once the PIN is passed', () => {
+  const r = makeRunner(['a', 'b'])
+  assert.equal(r.step({ dists: [15, 300], ok: [false, true] }), null)
+  assert.equal(r.step({ dists: [12, 300], ok: [false, true] }), null)
+  const d = r.step({ dists: [26, 300], ok: [false, true] })
+  assert.equal(d?.reason, 'passed')
+  assert.deepEqual(r.played, ['a'])
+})
+
+test('GPS gap: closest fix was 35 m before and 35 m after → voice still plays (late)', () => {
+  const r = makeRunner(['a', 'b'])
+  assert.equal(r.step({ dists: [105, 400] }), null)
+  assert.equal(r.step({ dists: [35, 330] }), null)
+  assert.equal(r.step({ dists: [35, 260] }), null)
+  assert.equal(r.step({ dists: [105, 190] })?.reason, 'passed')
+})
+
+test('lookahead: GPS jumped to the following PIN → it plays, the missed one is passed silently', () => {
+  const r = makeRunner(['a', 'b', 'c'])
+  r.step({ dists: [50, 130, 400] })
+  const d = r.step({ dists: [70, 8, 300] })
+  assert.equal(d?.reason, 'lookahead')
+  assert.equal(d?.index, 1)
+  assert.deepEqual(d?.skipped, [0])
+  assert.deepEqual(r.played, ['b'])
+  assert.ok(r.triggered.has('a'), 'missed PIN must not block the sequence')
+})
+
+test('no skipping when the expected PIN was never approached (loops / overlapping streets)', () => {
+  const r = makeRunner(['a', 'b', 'c'])
+  assert.equal(r.step({ dists: [500, 600, 10] }), null)
+  assert.equal(r.step({ dists: [500, 5, 400] }), null)
+  assert.deepEqual(r.played, [])
+})
+
+test('lookahead is limited to the next 2 PINs', () => {
+  const r = makeRunner(['a', 'b', 'c', 'd'])
+  r.step({ dists: [50, 400, 400, 400] })
+  assert.equal(r.step({ dists: [90, 400, 400, 5] }), null)
+})
+
+test('busy defers playback but not tracking; nothing is lost afterwards', () => {
+  const r = makeRunner(['a'])
+  assert.equal(r.step({ dists: [10] }, true), null)
+  assert.equal(r.step({ dists: [10] })?.reason, 'in-range')
+})
+
+test('duplicate prevention: a triggered PIN is never returned again', () => {
+  const r = makeRunner(['a', 'b'])
+  r.step({ dists: [5, 300] })
+  for (let i = 0; i < 5; i++) assert.equal(r.step({ dists: [5, 300] }), null)
+  assert.deepEqual(r.played, ['a'])
+})
+
+test('all PINs triggered → nothing to do', () => {
+  const r = makeRunner(['a'])
+  r.step({ dists: [1] })
+  assert.equal(r.step({ dists: [1] }), null)
+})
+
+test('simulated drives: every PIN voice plays exactly once, in order, at many speeds', () => {
+  const pinPos = [200, 420, 640, 700, 1000, 1500]
+  const ids = pinPos.map((_, i) => 'p' + i)
+  for (const speed of [3, 8, 14, 22, 30, 45, 60, 70]) {
+    const r = makeRunner(ids)
+    for (let x = 0; x < 1900; x += speed) {
+      r.step({ dists: pinPos.map((p) => Math.abs(p - x)) })
+    }
+    assert.deepEqual(r.played, ids, 'speed ' + speed + ' m per fix')
+  }
+})
+
+test('simulated drive with GPS dropouts (random gaps) never loses or repeats a voice', () => {
+  const pinPos = [150, 400, 650, 900]
+  const ids = pinPos.map((_, i) => 'p' + i)
+  let seed = 7
+  const rnd = () => ((seed = (seed * 16807) % 2147483647) / 2147483647)
+  for (let run = 0; run < 200; run++) {
+    const r = makeRunner(ids)
+    let x = 0
+    while (x < 1300) {
+      x += 8 + rnd() * 55
+      r.step({ dists: pinPos.map((p) => Math.abs(p - x)) })
+    }
+    assert.deepEqual(r.played, ids, 'run ' + run)
+  }
+})
