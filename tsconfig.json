{
  "compilerOptions": {
    "target": "ES2022",
    "useDefineForClassFields": true,
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "skipLibCheck": true,
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "allowImportingTsExtensions": true,
    "isolatedModules": true,
    "moduleDetection": "force",
    "noEmit": true,
    "jsx": "react-jsx",
    "strict": false,                  /* შეცვალეთ false-ზე */
    "noUnusedLocals": false,           /* შეცვალეთ false-ზე (აშორებს unused variables ერორებს) */
    "noUnusedParameters": false,       /* შეცვალეთ false-ზე (აშორებს unused params ერორებს) */
    "noImplicitAny": false,            /* დაამატეთ */
    "noFallthroughCasesInSwitch": true,
    "paths": {
      "@/*": ["./src/*"]
    },
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true
  },
  "include": ["src", "api"],
  "references": [{ "path": "./tsconfig.node.json" }]
}